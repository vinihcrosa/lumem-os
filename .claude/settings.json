{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(npm unpublish)",
      "Bash(npm unpublish *)",
      "Bash(npm dist-tag)",
      "Bash(npm dist-tag *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push --tags)",
      "Bash(git push --tags *)",
      "Bash(git push --no-verify)",
      "Bash(git push --no-verify *)",
      "Bash(git commit --no-verify)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n)",
      "Bash(git commit -n *)",
      "Bash(gh repo delete)",
      "Bash(gh repo delete *)",
      "Bash(gh api -X DELETE)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(rm -rf ~/.lumem)",
      "Bash(rm -rf ~/.lumem *)",
      "Read(~/.npmrc)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Edit(~/.lumem/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.config/husky/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings --experimental-strip-types \"$CLAUDE_PROJECT_DIR/scripts/harness/guard.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
