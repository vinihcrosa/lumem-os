{
  "name": "lumem-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "tsx scripts/run-ensure-pty-helper.ts",
    "prepare": "husky",
    "dev": "./scripts/workspace/run.sh",
    "dev:turbo": "turbo dev",
    "storybook": "pnpm --filter @lumem/web storybook",
    "build": "turbo build",
    "version:set": "tsx scripts/run-set-version.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo typecheck --concurrency=${TURBO_CONCURRENCY:-3}",
    "lint": "oxlint --type-aware --max-warnings 0 packages scripts e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gate:quick": "tsx scripts/run-gate-quick.ts",
    "gate:full": "vitest run && playwright test",
    "gate:build": "pnpm typecheck && pnpm lint && turbo build --concurrency=${TURBO_CONCURRENCY:-3}",
    "gate:mutation": "tsx scripts/run-mutation.ts",
    "docs:check": "tsx scripts/run-check-docs.ts",
    "feature:check": "tsx scripts/feature-flow/run.ts",
    "adapters:check": "tsx scripts/run-check-adapters.ts",
    "smoke:install": "tsx scripts/smoke-install.ts",
    "smoke:service": "tsx scripts/smoke-service.ts",
    "measure:resources": "pnpm --filter @lumem/server exec tsx src/testing/measure-resources.ts",
    "measure:thinking": "tsx scripts/measure-thinking.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "^9.1.7",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ]
  }
}
