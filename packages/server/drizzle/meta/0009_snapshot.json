          "value": "(\"session\".\"kind\" = 'script' AND \"session\".\"script_name\" IS NOT NULL\n          AND \"session\".\"script_name\" IN ('setup', 'run', 'teardown'))\n        OR (\"session\".\"kind\" <> 'script' AND \"session\".\"script_name\" IS NULL)"
        },
